# Copy to .env.local (never commit that file).
#
# Optional. Without a key the job-ad mapper and "Ask the data" use the built-in
# matcher and figure lookup, and say so on screen.
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AQ.Ab.......

# Optional. Model to try first; the free-tier Flash models are tried after it.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Serve another pipeline output folder (it must also contain geo/).
# KR_DATA_DIR=
